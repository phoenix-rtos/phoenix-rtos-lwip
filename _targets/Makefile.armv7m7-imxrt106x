NET_DRIVERS_SUPPORTED := pppou pppos enet
ifeq ($(LWIP_G3_BUILD), yes)
NET_DRIVERS_SUPPORTED += g3plc
endif

NET_DRIVERS ?= $(NET_DRIVERS_SUPPORTED)
PPPOS_MODEM ?= huawei

DRIVERS_SRCS_enet = imx-enet.c $(DRIVERS_SRCS_UTIL)

PHY_DRIVERS_SUPPORTED := ksz8081rnx
PHY_DRIVERS ?= $(PHY_DRIVERS_SUPPORTED)
PHY_SRCS_ksz8081rnx = ephy/ksz8081rnx.c
PHY_SRCS_COMMON = imxrt-gpio.c
